@echo off
set "PROJECT_DIR=C:\github-projects\digital-twin-classifier-jev"

powershell.exe -NoLogo -NoExit -ExecutionPolicy Bypass -Command "$ErrorActionPreference = 'Stop'; if (-not (Test-Path -LiteralPath $env:PROJECT_DIR -PathType Container)) { throw 'Project directory not found.' }; Set-Location -LiteralPath $env:PROJECT_DIR; Write-Host '==> Switching to main' -ForegroundColor Cyan; git fetch origin main; if ($LASTEXITCODE -ne 0) { throw 'git fetch origin main failed.' }; git switch main; if ($LASTEXITCODE -ne 0) { throw 'git switch main failed; check local changes.' }; Write-Host '==> Pulling main' -ForegroundColor Cyan; git pull --ff-only origin main; if ($LASTEXITCODE -ne 0) { throw 'git pull origin main failed.' }; if (-not (Test-Path -LiteralPath 'src\startup_adherence' -PathType Container)) { git status -sb; throw 'src\startup_adherence is missing on main; check whether sparse checkout is enabled.' }; if (-not (Test-Path -LiteralPath '.venv\Scripts\python.exe')) { Write-Host '==> Creating virtual environment' -ForegroundColor Cyan; py -m venv .venv; if ($LASTEXITCODE -ne 0) { throw 'Virtual environment creation failed.' } }; . .\.venv\Scripts\Activate.ps1; Write-Host '==> Installing project and development dependencies' -ForegroundColor Cyan; python -m pip install -e '.[dev]'; if ($LASTEXITCODE -ne 0) { throw 'pip install failed.' }; Write-Host '==> Running pytest' -ForegroundColor Cyan; python -m pytest -q; if ($LASTEXITCODE -ne 0) { throw 'pytest failed.' }; Write-Host '==> Running Ruff checks' -ForegroundColor Cyan; python -m ruff check src tests orchestrator.py fit.py; if ($LASTEXITCODE -ne 0) { throw 'ruff check failed.' }; Write-Host '==> Checking Ruff formatting' -ForegroundColor Cyan; python -m ruff format --check src tests orchestrator.py fit.py; if ($LASTEXITCODE -ne 0) { throw 'ruff format check failed.' }; Write-Host ''; Write-Host 'Bootstrap complete. Virtual environment is active.' -ForegroundColor Green"
